{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@hatlock/shared": ["./packages/shared/src/index.ts"],
      "@hatlock/database": ["./packages/database/src/index.ts"],
      "@hatlock/hatpesa": ["./packages/hatpesa/src/index.ts"],
      "@hatlock/sonicpesa": ["./packages/sonicpesa/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "apps/api/src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/node_modules",
    "agents",
    "apps/web",
    "apps/customer-portal"
  ]
}
