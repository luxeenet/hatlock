# ==============================================================================
# HATLOCK BY LUXEENET — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure with production credentials
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=hatlock
POSTGRES_PASSWORD=hatlock_dev_pass_2026
POSTGRES_DB=hatlock_db
DATABASE_URL="postgresql://hatlock:hatlock_dev_pass_2026@postgres:5432/hatlock_db?schema=public"

# Cache & Message Broker (Redis 7)
REDIS_URL="redis://redis:6379"

# API Server
PORT=3000
NODE_ENV=production
API_BASE_URL="https://api.luxeenet.com"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="https://admin.luxeenet.com,https://portal.luxeenet.com"

# Cryptography & Token Keys
# JWT ES256 Key Pair (Generate with: openssl ecparam -name prime256v1 -genkey -noout -out private.pem && openssl ec -in private.pem -pubout -out public.pem)
JWT_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Refresh Token Secret (At least 32 characters, e.g. openssl rand -hex 32)
REFRESH_TOKEN_SECRET="replace-with-minimum-32-character-random-hex-string-for-refresh-tokens"

# AES-256 Symmetric Encryption Key for Sensitive DB Credentials (At least 32 characters)
ENCRYPTION_KEY="replace-with-minimum-32-character-random-hex-string-for-aes256"

# Command Signing Keys (ECDSA P-256 for Agent command integrity)
COMMAND_SIGNING_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
COMMAND_SIGNING_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# HatPesa Mobile Money Integration
HATPESA_ENVIRONMENT=sandbox
HATPESA_BASE_URL="https://sandbox.hatpesa.com"
HATPESA_API_KEY="hp_test_key_luxeenet"
HATPESA_API_SECRET="hp_test_secret_luxeenet"
HATPESA_WEBHOOK_SECRET="hp_test_webhook_secret_luxeenet"
HATPESA_TEST_MODE=true

# SonicPesa Payment Gateway Integration
SONICPESA_BASE_URL="https://api.sonicpesa.com/api/v1"
SONICPESA_API_KEY=""
SONICPESA_API_SECRET=""
SONICPESA_WEBHOOK_SECRET=""
SONICPESA_TEST_MODE=true

# Frontend Applications
NEXT_PUBLIC_API_URL="https://api.luxeenet.com"
NEXT_PUBLIC_APP_NAME="HatLock by Luxeenet"

# Email & Notifications (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@hatlock.luxeenet.com"

# Logging & Monitoring
LOG_LEVEL="info"
