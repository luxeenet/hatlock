# ==============================================================================
# HATLOCK BY LUXEENET — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or deployment
# ==============================================================================

# Database (PostgreSQL 16)
POSTGRES_USER=hatlock
POSTGRES_PASSWORD=hatlock_dev_pass_2026
POSTGRES_DB=hatlock_db
DATABASE_URL="postgresql://hatlock:hatlock_dev_pass_2026@localhost:5432/hatlock_db?schema=public"

# Cache & Message Broker (Redis 7)
REDIS_URL="redis://localhost:6379"

# API Server
PORT=3000
NODE_ENV=development
API_BASE_URL="http://localhost:3000"

# Authentication & Cryptography
JWT_SECRET="replace-with-minimum-32-character-random-hex-string-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-minimum-32-character-random-hex-string-for-refresh-tokens"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Command Signing Keys (ECDSA P-256 for Agent command integrity)
COMMAND_SIGNING_PRIVATE_KEY=""
COMMAND_SIGNING_PUBLIC_KEY=""

# HatPesa Mobile Money Integration
HATPESA_ENVIRONMENT=sandbox
HATPESA_BASE_URL="https://sandbox.hatpesa.com"
HATPESA_API_KEY="hp_test_key_luxeenet"
HATPESA_API_SECRET="hp_test_secret_luxeenet"
HATPESA_WEBHOOK_SECRET="hp_test_webhook_secret_luxeenet"

# SonicPesa Payment Gateway Integration
SONICPESA_BASE_URL="https://api.sonicpesa.com/api/v1"
SONICPESA_API_KEY=""
SONICPESA_API_SECRET=""
SONICPESA_WEBHOOK_SECRET=""
SONICPESA_TEST_MODE=true

# Frontend Applications
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="HatLock by Luxeenet"

# Email & Notifications (SMTP)
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@hatlock.luxeenet.com"

# Logging & Monitoring
LOG_LEVEL="info"
